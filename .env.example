# ==========================================
# FOODWISE AI — Environment Configuration
# ==========================================

# Security & Session Authentication
SECRET_KEY=foodwise-ai-production-super-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to local SQLite, compatible with PostgreSQL)
DATABASE_URL=sqlite:///data/foodwise.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/foodwise_db

# Model Checkpoints
YOLO_WEIGHTS_PATH=models/best.pt

# Roboflow Dataset API (Optional: required only when downloading new versions from Roboflow Universe)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
